<%- include('../partials/head') %>

<div class="container-fluid">
    <div class="row flex-nowrap">
        
        <!-- Menú lateral izquierdo -->
        <%- include('../partials/sidebar') %>
        
        <!-- Columna derecha del contenido principal -->
        <div class="col py-3 fn-main-container" style="background: #f8fafc; min-height: 100vh; padding: 25px;">
            <div style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); max-width: 950px; margin: 20px auto;">
                
                <h2 style="color: #1e3a8a; margin-bottom: 25px; font-weight: 700; border-bottom: 2px solid #f3f4f6; padding-bottom: 10px;">
                    👤 Registrar Nuevo Cliente
                </h2>

                <!-- Mensajes Flash de Alerta -->
                <% if (typeof mensajeError !== 'undefined' && mensajeError && mensajeError.length > 0) { %>
                    <div class="alert alert-danger" role="alert"><%= mensajeError %></div>
                <% } %>

                <form action="/clientes/guardar" method="POST" enctype="multipart/form-data">
                    
                    <!-- 📋 SECTOR 1: Información Personal Obligatoria -->
                    <h3 style="color: #1e3a8a; font-size: 16px; font-weight: 700; margin-bottom: 15px; border-bottom: 1px solid #e2e8f0; padding-bottom: 5px;">📋 Datos de Identificación</h3>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label style="display: block; font-weight: 600; color: #4b5563; margin-bottom: 8px;">Nombres del Cliente:</label>
                            <input type="text" name="nombre" required placeholder="Ej. Juan Carlos" style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 15px; outline: none;">
                        </div>
                        <div>
                            <label style="display: block; font-weight: 600; color: #4b5563; margin-bottom: 8px;">Apellidos del Cliente:</label>
                            <input type="text" name="apellido" required placeholder="Ej. Pérez Gómez" style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 15px; outline: none;">
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label style="display: block; font-weight: 600; color: #4b5563; margin-bottom: 8px;">Número de DNI:</label>
                            <input type="text" name="dni" required maxlength="8" placeholder="Ej. 45678912" style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 15px; outline: none;">
                        </div>
                        <div>
                            <label style="display: block; font-weight: 600; color: #4b5563; margin-bottom: 8px;">Correo Electrónico (Opcional):</label>
                            <input type="email" name="email" placeholder="Ej. cliente@correo.com" style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 15px; outline: none;">
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label style="display: block; font-weight: 600; color: #4b5563; margin-bottom: 8px;">Teléfono / Celular:</label>
                            <input type="text" name="telefono" placeholder="Ej. 987654321" style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 15px; outline: none;">
                        </div>
                        <div>
                            <label style="display: block; font-weight: 600; color: #4b5563; margin-bottom: 8px;">Dirección de Domicilio:</label>
                            <input type="text" name="direccion" placeholder="Ej. Jr. Tumbes 456" style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 15px; outline: none;">
                        </div>
                    </div>

                    <!-- NUEVO CAMPO: Referencia de Domicilio -->
                    <div style="margin-bottom: 20px;">
                        <label style="display: block; font-weight: 600; color: #4b5563; margin-bottom: 8px;">Referencia de Domicilio:</label>
                        <input type="text" name="referencia_domicilio" placeholder="Ej. Frente al parque principal, Portón verde" style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 15px; outline: none;">
                    </div>

                                        <!-- 💼 SECTOR 2: Información Económica y de Negocio -->
                    <h3 style="color: #1e3a8a; font-size: 16px; font-weight: 700; margin-top: 30px; margin-bottom: 15px; border-bottom: 1px solid #e2e8f0; padding-bottom: 5px;">💼 Información Económica y de Negocio</h3>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label style="display: block; font-weight: 600; color: #4b5563; margin-bottom: 8px;">Giro / Nombre del Negocio:</label>
                            <input type="text" name="negocio" placeholder="Ej. Bodega, Tienda de ropa" style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 15px; outline: none;">
                        </div>
                        <div>
                            <label style="display: block; font-weight: 600; color: #4b5563; margin-bottom: 8px;">Dirección del Negocio:</label>
                            <input type="text" name="direccion_negocio" placeholder="Ej. Av. Principal 123" style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 15px; outline: none;">
                        </div>
                    </div>

                    <!-- 🏦 SECTOR 3: Datos Bancarios y Digitales -->
                    <h3 style="color: #1e3a8a; font-size: 16px; font-weight: 700; margin-top: 25px; margin-bottom: 15px; border-bottom: 1px solid #e2e8f0; padding-bottom: 5px;">💳 Cuentas de Recaudo</h3>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label style="display: block; font-weight: 600; color: #4b5563; margin-bottom: 8px;">N° Cuenta Banco BCP:</label>
                            <input type="text" name="cuenta_bcp" placeholder="Ej. 310-98765432-0-12" style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 15px; outline: none;">
                        </div>
                        <div>
                            <label style="display: block; font-weight: 600; color: #4b5563; margin-bottom: 8px;">Número de Yape:</label>
                            <input type="text" name="numero_yape" placeholder="Ej. 912345678" style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 15px; outline: none;">
                        </div>
                    </div>

                    <!-- 📸 SECTOR 4: Adjuntar Fotografías (NUEVO DISEÑO PARA 4 FOTOS) -->
                    <h3 style="color: #1e3a8a; font-size: 16px; font-weight: 700; margin-top: 25px; margin-bottom: 15px; border-bottom: 1px solid #e2e8f0; padding-bottom: 5px;">📷 Archivos y Fotos Adjuntas</h3>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
                        <div>
                            <label style="display: block; font-weight: 600; color: #4b5563; margin-bottom: 8px;">Foto 1 (Fachada / Negocio):</label>
                            <input type="file" name="fotos" accept="image/*" style="width: 100%; font-size: 14px; outline: none;">
                        </div>
                        <div>
                            <label style="display: block; font-weight: 600; color: #4b5563; margin-bottom: 8px;">Foto 2 (DNI Anverso):</label>
                            <input type="file" name="fotos" accept="image/*" style="width: 100%; font-size: 14px; outline: none;">
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px;">
                        <div>
                            <label style="display: block; font-weight: 600; color: #4b5563; margin-bottom: 8px;">Foto 3 (DNI Reverso):</label>
                            <input type="file" name="fotos" accept="image/*" style="width: 100%; font-size: 14px; outline: none;">
                        </div>
                        <div>
                            <label style="display: block; font-weight: 600; color: #4b5563; margin-bottom: 8px; color: #16a34a;">Foto 4 (Recibo Luz / Agua):</label>
                            <input type="file" name="fotos" accept="image/*" style="width: 100%; font-size: 14px; outline: none;">
                        </div>
                    </div>

                    <!-- 💾 BOTONERA UNIFICADA DE ACCIÓN -->
                    <div style="margin-top: 40px; display: flex; justify-content: space-between; align-items: center; border-top: 2px solid #f3f4f6; padding-top: 20px;">
                        <a href="/clientes" style="background: white; color: #64748b; border: 1px solid #cbd5e1; text-decoration: none; padding: 12px 25px; border-radius: 6px; font-weight: 600; font-size: 15px;">Cancelar y Volver</a>
                        <button type="submit" style="background: #2563eb; color: white; border: none; padding: 12px 35px; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 15px; box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);">
                            💾 Guardar Cliente Completo
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

<%- include('../partials/footer') %>
