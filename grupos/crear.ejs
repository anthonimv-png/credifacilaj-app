<%- include('../partials/head') %>

<div class="container-fluid">
    <div class="row flex-nowrap">
        
        <!-- Menú lateral izquierdo de CREDIFACIL A&J -->
        <%- include('../partials/sidebar') %>
        
        <!-- Contenedor Principal del Formulario de Creación -->
        <div class="col py-3 fn-main-container" style="background: #f8fafc; min-height: 100vh; padding: 25px;">
            <div style="max-width: 850px; margin: 20px auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); border: 1px solid #e2e8f0;">
                
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 25px; border-bottom: 2px solid #f1f5f9; padding-bottom: 15px;">
                    <h2 style="color: #1e3a8a; margin: 0; font-weight: 800; font-size: 24px;">👥 Crear Nuevo Grupo de Crédito</h2>
                </div>

                <!-- 🧠 CONTROL DE REDIRECCIÓN: Desactivamos el submit por defecto de HTML para que actúe tu JavaScript de forma limpia -->
                <form id="formCrearGrupo" onsubmit="event.preventDefault();">
                    
                    <!-- Nombre del Nuevo Grupo -->
                    <div style="margin-bottom: 20px;">
                        <label style="font-weight: 700; color: #334155; font-size: 14px; display: block; margin-bottom: 6px;">Nombre del Grupo:</label>
                        <input type="text" id="nombre_nuevo_grupo" placeholder="Ej. SAN JOSÉ" required style="width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-weight: 600; color: #334155; text-transform: uppercase;">
                    </div>

                    <!-- Buscar Cliente para Agregar (Buscador Automatizado Validado) -->
                    <div style="margin-bottom: 25px; position: relative;">
                        <label style="font-weight: 700; color: #334155; font-size: 14px; display: block; margin-bottom: 6px;">Buscar Cliente para Agregar:</label>
                        <input type="text" id="input_buscar_cliente_crear" onkeyup="filtrarClientesCrearGrupo()" placeholder="Escribe el nombre o DNI del cliente..." style="width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-weight: 600; color: #1e293b;" autocomplete="off">
                        
                        <!-- Caja desplegable flotante de resultados -->
                        <div id="lista_desplegable_clientes_crear" style="display: none; position: absolute; top: 100%; left: 0; right: 0; background: white; border: 1px solid #cbd5e1; border-radius: 0 0 6px 6px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); z-index: 1000; max-height: 200px; overflow-y: auto;"></div>
                    </div>

                    <!-- Miembros del Grupo Seleccionados -->
                    <label style="font-weight: 700; color: #334155; font-size: 14px; display: block; margin-bottom: 12px;">Miembros del Grupo Seleccionados</label>
                    
                    <div class="table-responsive" style="border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; margin-bottom: 30px;">
                        <table class="table" style="margin-bottom: 0; vertical-align: middle; text-align: center;">
                            <thead style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                                <tr style="font-size: 12px; color: #64748b; font-weight: 700; text-transform: uppercase;">
                                    <th style="padding: 10px; text-align: left;">Cliente</th>
                                    <th style="padding: 10px;">Etiqueta / Rol</th>
                                    <th style="padding: 10px; width: 100px;">Acción</th>
                                </tr>
                            </thead>
                            <tbody id="contenedor_miembros_nuevos">
                                <tr id="fila_vacia_crear">
                                    <td colspan="3" style="padding: 20px; text-align: center; color: #94a3b8; font-style: italic; font-size: 13.5px;">
                                        Ningún cliente seleccionado aún. Usa el buscador de arriba.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Botonera de Control -->
                    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 20px;">
                        <a href="/grupos/" style="text-decoration: none; color: #64748b; font-weight: 700; font-size: 14px;">⬅️ Volver al Historial</a>
                        <button type="button" onclick="procesarGuardadoNuevoGrupoMasivo()" style="background: #2563eb; color: white; border: none; padding: 10px 25px; border-radius: 6px; font-weight: 700; font-size: 14px; cursor: pointer; box-shadow: 0 4px 6px rgba(37,99,235,0.15); display: inline-flex; align-items: center; gap: 6px;">
                            💾 Guardar Grupo Completo
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

<!-- 📦 CORRECCIÓN DE IMPORTACIÓN: Cargamos SweetAlert2 desde el CDN oficial verificado y estable de red -->
<script src="https://jsdelivr.net"></script>
<script>
async function filtrarClientesCrearGrupo() {
    const palabra = document.getElementById('input_buscar_cliente_crear').value.trim();
    const desplegable = document.getElementById('lista_desplegable_clientes_crear');
    
    if (palabra.length < 2) {
        desplegable.style.display = 'none';
        return;
    }
    try {
        // Consultamos de forma asíncrona la nueva API de auditoría relacional de Laragon
        const responseClientes = await fetch('/grupos/buscar-cliente-inline?q=' + encodeURIComponent(palabra));
        
        if (!responseClientes.ok) return;
        const clientesFormateados = await responseClientes.json();

        if (clientesFormateados.length === 0) {
            desplegable.innerHTML = '<div style="padding: 10px; color: #64748b; font-style: italic; font-size: 13px; text-align: center;">⚠️ No se encontraron clientes registrados con ese criterio.</div>';
            desplegable.style.display = 'block';
            return;
        }

        desplegable.innerHTML = '';
        desplegable.style.display = 'block';

        clientesFormateados.forEach(c => {
            const div = document.createElement('div');
            div.style = "padding: 10px 15px; cursor: pointer; border-bottom: 1px solid #f1f5f9; font-weight: 700; font-size: 13.5px; color: #1e293b; transition: background 0.2s;";
            div.onmouseover = function() { this.style.background = "#f8fafc"; };
            div.onmouseout = function() { this.style.background = "white"; };
            
            div.innerHTML = `👤 ${c.nombre} <div style="font-size: 11px; color: #64748b; font-weight: 600; margin-top: 2px;">💳 DNI: ${c.dni}</div>`;
            
            div.onclick = async function() {
                // 🛑 ESCUDO 1: Bloqueo contundente de riesgo por créditos Vigentes o Vencidos
                if (c.tiene_credito_activo) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Operación Rechazada',
                        text: `${c.motivo_credito}. No está permitido sumarlo a otra junta hasta que cancele sus deudas pendientes en caja.`,
                        confirmButtonColor: '#dc3545'
                    });
                    document.getElementById('input_buscar_cliente_crear').value = '';
                    desplegable.style.display = 'none';
                    return;
                }

                // ⚠️ ESCUDO 2: Advertencia de pertenencia a otra junta (Habilita traslado físico automático)
                if (c.pertenece_a_grupo) {
                    Swal.fire({
                        title: '¿Confirmar traslado de grupo?',
                        text: `El cliente "${c.nombre}" ya pertenece al grupo activo "${c.grupo_nombre_viejo}". ¿Deseas removerlo de su grupo viejo y traerlo a esta nueva junta?`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#2563eb',
                        cancelButtonColor: '#64748b',
                        confirmButtonText: 'Sí, trasladar',
                        cancelButtonText: 'Cancelar'
                    }).then(async (result) => {
                        if (result.isConfirmed) {
                            // Ejecutamos la remoción física relacional en Laragon
                            const resTraslado = await fetch('/grupos/trasladar-cliente-grupo-api', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ cliente_id: c.id })
                            });
                            
                            if (resTraslado.ok) {
                                agregarFilaNuevaAlGrupo(c.id, c.nombre, c.dni);
                                Swal.fire('¡Éxito!', 'El cliente ha sido desvinculado de su grupo anterior y añadido a la tabla actual.', 'success');
                            }
                        }
                    });
                    
                    document.getElementById('input_buscar_cliente_crear').value = '';
                    desplegable.style.display = 'none';
                    return;
                }

                // 👍 LUZ VERDE DIRECTA: Si el cliente está 100% liquidado y libre, se suma normalmente
                agregarFilaNuevaAlGrupo(c.id, c.nombre, c.dni);
                desplegable.style.display = 'none';
                document.getElementById('input_buscar_cliente_crear').value = '';
            };
            desplegable.appendChild(div);
        });
    } catch(err) {
        console.error("Error en el buscador validado:", err);
    }
}

function agregarFilaNuevaAlGrupo(id, nombreCompleto, dni) {
    const tbody = document.getElementById('contenedor_miembros_nuevos');
    const filaVacia = document.getElementById('fila_vacia_crear');
    if (filaVacia) filaVacia.remove();

    const yaExiste = document.querySelector(`tr[data-cliente-id="${id}"]`);
    if (yaExiste) {
        alert("⚠️ Este cliente ya fue seleccionado en la cuadrícula inferior.");
        return;
    }

    const tr = document.createElement('tr');
    tr.className = "fila-cliente-nueva-junta";
    tr.setAttribute('data-cliente-id', id);
    tr.style = "border-bottom: 1px solid #f1f5f9; font-size: 14px;";
    tr.innerHTML = `
        <td style="padding: 12px; text-align: left; font-weight: 700; color: #1e293b; text-transform: uppercase;">
            👤 ${nombreCompleto}
            <div style="font-size: 11px; color: #64748b; font-weight: 600; margin-top: 2px;">💳 DNI: ${dni}</div>
        </td>
        <td style="padding: 12px;">
            <select class="select-rol-nuevo" style="padding: 4px 8px; border-radius: 4px; border: 1px solid #cbd5e1; font-weight: 600; color: #334155;">
                <option value="Integrante" selected>Integrante</option>
                <option value="Coordinadora">Coordinadora / Líder</option>
            </select>
        </td>
        <td style="padding: 12px;">
            <button type="button" onclick="quitarFilaNuevaDeLaTabla(this)" style="background: #fee2e2; color: #b91c1c; border: none; padding: 4px 10px; border-radius: 4px; font-weight: 700; font-size: 12px; cursor: pointer;">❌ Quitar</button>
        </td>
    `;
    tbody.appendChild(tr);
}

function quitarFilaNuevaDeLaTabla(boton) {
    boton.closest('tr').remove();
    const tbody = document.getElementById('contenedor_miembros_nuevos');
    if (tbody.children.length === 0) {
        tbody.innerHTML = `
            <tr id="fila_vacia_crear">
                <td colspan="3" style="padding: 20px; text-align: center; color: #94a3b8; font-style: italic; font-size: 13.5px;">
                    Ningún cliente seleccionado aún. Usa el buscador de arriba.
                </td>
            </tr>`;
    }
}

async function procesarGuardadoNuevoGrupoMasivo() {
    try {
        const nombreGrupo = document.getElementById('nombre_nuevo_grupo').value.trim();
        if (!nombreGrupo) {
            Swal.fire('Atención', 'Por favor, digita un nombre para el nuevo grupo.', 'warning');
            return;
        }

        // 🧠 REPARACIÓN MAESTRA: Capturamos de forma absoluta todas las filas activas en la tabla inferior
        const filas = Array.from(document.querySelectorAll('.fila-cliente-nueva-junta'));
        
        if (filas.length === 0) {
            Swal.fire('Atención', '⚠️ Por favor, añade al menos un cliente a la tabla antes de guardar el grupo.', 'warning');
            return;
        }

        const miembrosAAsentar = [];

        // Forzamos un bucle plano nativo garantizando que indexe a la totalidad de las clientas registradas
        for (let i = 0; i < filas.length; i++) {
            const fila = filas[i];
            const cId = parseInt(fila.getAttribute('data-cliente-id'));
            const selectRol = fila.querySelector('.select-rol-nuevo');
            const rolAsignado = selectRol ? selectRol.value : 'Integrante';

            if (cId) {
                miembrosAAsentar.push({
                    cliente_id: cId,
                    rol: rolAsignado
                });
            }
        }

        console.log(` Despachando lote completo de ${miembrosAAsentar.length} integrantes hacia Laragon...`);

        // Despachamos el payload atómico hacia el enrutador backend unificado
        const response = await fetch('/grupos/guardar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nombre: nombreGrupo, integrantes: miembrosAAsentar })
        });

        const resData = await response.json();

        // Escudo interactivo si el nombre ya existía
        if (resData.status === 'duplicado') {
            Swal.fire({
                icon: 'error',
                title: 'Grupo Duplicado',
                text: resData.mensaje,
                confirmButtonColor: '#dc3545'
            });
            return;
        }

        if (resData.status === 'success' || response.ok) {
            Swal.fire({
                icon: 'success',
                title: '¡Registrado!',
                text: '✅ ¡Nuevo Grupo de Crédito registrado con éxito total en Laragon!',
                confirmButtonColor: '#2563eb'
            }).then(() => {
                window.location.href = '/grupos/';
            });
        } else {
            Swal.fire('Error', resData.mensaje || 'Inconveniente al procesar el registro.', 'error');
        }

    } catch (error) {
        console.error("Error en la ejecución del guardado visual:", error);
        Swal.fire('Error de Red', 'Inconveniente de red al procesar el registro masivo.', 'error');
    }
}
document.addEventListener("click", function(e) {
    if (e.target.id !== 'input_buscar_cliente_crear') {
        document.getElementById('lista_desplegable_clientes_crear').style.display = 'none';
    }
});
</script>

<%- include('../partials/footer') %>
