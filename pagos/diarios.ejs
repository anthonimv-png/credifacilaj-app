<%- include('../partials/head') %>

<div class="container-fluid">
    <div class="row flex-nowrap">
        
        <!-- Menú lateral izquierdo -->
        <%- include('../partials/sidebar') %>
        
        <!-- Cuerpo Principal del Tablero -->
        <div class="col py-3 fn-main-container" style="background: #f8fafc; min-height: 100vh; padding: 25px;">
            <div style="max-width: 1200px; margin: 10px auto;">
                
                <!-- Encabezado superior con Formulario de Doble Fecha (Rango) -->
                <div style="background: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); margin-bottom: 25px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
                        <div>
                            <h2 style="color: #1e3a8a; margin: 0; font-weight: 700;">🗓️ Planilla de Liquidación Diaria</h2>
                            <p style="color: #64748b; margin: 3px 0 0 0;">Seguimiento de deudas por asesores, juntas masivas e integrantes.</p>
                        </div>
                        
                        <!-- Formulario Inteligente Filtrador por Rango -->
                        <form action="/planilla/diarios" method="GET" style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; background: #f1f5f9; padding: 10px 15px; border-radius: 8px; border: 1px solid #cbd5e1;">
                            
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <label style="font-weight: 700; color: #475569; font-size: 13px; margin: 0;">Desde:</label>
                                <input type="date" name="fecha_desde" value="<%= fechaDesde %>" style="border: 1px solid #cbd5e1; border-radius: 4px; padding: 4px 6px; font-weight: 600; color: #1e3a8a; outline: none; font-size: 13px;">
                            </div>

                            <div style="display: flex; align-items: center; gap: 6px;">
                                <label style="font-weight: 700; color: #475569; font-size: 13px; margin: 0;">Hasta:</label>
                                <input type="date" name="fecha_hasta" value="<%= fechaHasta %>" style="border: 1px solid #cbd5e1; border-radius: 4px; padding: 4px 6px; font-weight: 600; color: #1e3a8a; outline: none; font-size: 13px;">
                            </div>

                            <button type="submit" style="background: #1e3a8a; color: white; border: none; padding: 5px 15px; border-radius: 4px; font-weight: 600; font-size: 13px; cursor: pointer;">
                                🔍 Filtrar
                            </button>

                            <% if (fechaDesde !== hoyFormateado || fechaHasta !== hoyFormateado) { %>
                                <a href="/planilla/diarios" style="font-size: 12px; text-decoration: none; color: #2563eb; font-weight: 700; padding-left: 5px;">📍 Hoy</a>
                            <% } %>
                        </form>
                    </div>
                </div>

                <!-- 📊 DOS TARJETAS GENERALES DE CAJA RESUMIDA -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px;">
                    <div style="background: white; padding: 22px; border-radius: 10px; border-left: 5px solid #2563eb; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
                        <span style="font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase;">Monto x Recaudar en Rango</span>
                        <h3 style="font-size: 28px; font-weight: 800; color: #1e293b; margin: 5px 0;"><%= empresa.moneda %> <%= montoXRecaudar %></h3>
                    </div>

                    <div style="background: #f0fdf4; padding: 22px; border-radius: 10px; border-left: 5px solid #16a34a; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
                        <span style="font-size: 12px; font-weight: 700; color: #15803d; text-transform: uppercase;">Monto Recaudado en Rango</span>
                        <h3 style="font-size: 28px; font-weight: 800; color: #16a34a; margin: 5px 0;"><%= empresa.moneda %> <%= montoRecaudado %></h3>
                    </div>
                </div>
                <!-- 👥 RENDERIZADO SEGMENTADO POR GRUPOS -->
                <% if (Object.keys(planilla).length === 0) { %>
                    <div style="background: white; border-radius: 12px; padding: 40px; text-align: center; color: #94a3b8; font-style: italic; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
                        ⚠️ No se registran juntas masivas programadas para el cobro en el rango de fechas seleccionado.
                    </div>
                <% } else { %>
                    <% Object.keys(planilla).forEach(function(idGrupo) { const gp = planilla[idGrupo]; %>
                        <div style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 4px 6px rgba(0,0,0,0.04); margin-bottom: 30px; border: 1px solid #e2e8f0;">
                            
                            <div style="background: #1e3a8a; color: white; padding: 12px 20px; border-radius: 8px; margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center;">
                                <h4 style="margin: 0; font-size: 15px; font-weight: 700; text-transform: uppercase;">👥 GRUPO: <%= gp.grupo_nombre %></h4>
                            </div>

                            <table class="table" style="vertical-align: middle; margin-bottom: 0; width: 100%;">
                                <thead style="background: #f8fafc;">
                                    <tr>
                                        <th style="font-size: 12px; color: #64748b; text-align: left;">Integrante</th>
                                        <th style="font-size: 12px; color: #64748b; text-align: center;">Cuotas Cobradas</th>
                                        <th style="font-size: 12px; color: #64748b; text-align: center;">Cuota Vencida</th>
                                        <th style="font-size: 12px; color: #64748b; text-align: right;">Monto x Recaudar</th>
                                        <th style="font-size: 12px; color: #64748b; text-align: right;">Monto Recaudado</th>
                                        <th style="font-size: 12px; color: #64748b; text-align: center;">Días Vencidos</th>
                                        <th style="font-size: 12px; color: #64748b; text-align: center;">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% gp.integrantes.forEach(function(integ) { %>
                                        <tr style="font-size: 13.5px;">
                                            <td>
                                                <strong><%= integ.nombre %></strong><br>
                                                <span style="font-size:11px;color:#64748b;">💳 DNI: <%= integ.dni %></span>
                                            </td>
                                            
                                            <!-- Cálculo estricto de cuotas en base al dinero acumulado en Laragon -->
                                            <td style="text-align: center; font-weight: bold; color: #2563eb;">
                                                <%= integ.cuotas_cobradas_string %>
                                            </td>

                                            <td style="text-align: center; font-weight: bold; color: #1e3a8a;">#<%= integ.cuota_numero %></td>
                                            
                                            <td style="text-align: right;">
                                                <%= empresa.moneda %> <%= parseFloat(integ.monto_x_recaudar).toFixed(2) %>
                                            </td>
                                            
                                            <td style="text-align: right; font-weight: 700; color: <%= integ.estado === 'Pagado' ? '#16a34a' : '#64748b' %>;">
                                                <%= empresa.moneda %> <%= parseFloat(integ.monto_recaudado).toFixed(2) %>
                                            </td>
                                            
                                            <td style="text-align: center;">
                                                <% if(integ.dias_vencidos > 0) { %>
                                                    <span style="color: #b91c1c; font-weight: 700; background: #fee2e2; padding: 2px 6px; border-radius: 4px;"><%= integ.dias_vencidos %> días</span>
                                                <% } else { %>
                                                    <span style="color:#94a3b8;">0</span>
                                                <% } %>
                                            </td>
                                            
                                            <td style="text-align: center;">
                                                <span style="background: <%= integ.estado === 'Pagado' ? '#dcfce7' : '#f1f5f9' %>; color: <%= integ.estado === 'Pagado' ? '#15803d' : '#475569' %>; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 6px;">
                                                    <%= integ.estado %>
                                                </span>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>

                        </div>
                    <% }); %>
                <% } %>

            </div>
        </div>

    </div>
</div>

<%- include('../partials/footer') %>
