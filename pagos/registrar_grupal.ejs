<%- include('../partials/head') %>

<div class="container-fluid">
    <div class="row flex-nowrap">
        
        <!-- Menú lateral izquierdo de CREDIFACIL A&J -->
        <%- include('../partials/sidebar') %>
        
        <!-- Contenedor Principal del Formulario Grupal -->
        <div class="col py-3 fn-main-container" style="background: #f8fafc; min-height: 100vh; padding: 25px;">
            <div style="max-width: 1000px; margin: 15px auto; background: white; padding: 35px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04); border: 1px solid #e2e8f0;">
                
                <!-- Encabezado Matriz -->
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 25px; border-bottom: 2px solid #f1f5f9; padding-bottom: 15px;">
                    <h2 style="color: #1e3a8a; margin: 0; font-weight: 800; font-size: 24px;">💰 Planilla de Cobranza Grupal</h2>
                    <span style="background: #dcfce7; color: #15803d; font-weight: 700; padding: 4px 10px; border-radius: 6px; font-size: 12px; text-transform: uppercase;">
                        👥 Junta: <%= grupo.nombre %>
                    </span>
                </div>

                <form id="formCobranzaGrupal">
                    
                    <!-- Ficha Superior de Parámetros Operativos -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 25px; background: #f8fafc; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 30px;">
                        
                        <!-- 🔄 SECTOR ACTUALIZADO: Métodos de Pago Integrados con Yape y Plin -->
                        <div>
                            <label style="font-weight: 700; color: #334155; font-size: 13.5px; display: block; margin-bottom: 6px;">Método de Pago:</label>
                            <select id="metodo_pago" name="metodo_pago" style="width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-weight: 600; color: #334155; background: white;">
                                <option value="Efectivo" selected>💵 Efectivo</option>
                                <option value="Transferencia Bancaria">🏦 Transferencia Bancaria</option>
                                <option value="Yape">📱 Yape</option>
                                <option value="Plin">💜 Plin</option>
                            </select>
                        </div>

                        <div>
                            <label style="font-weight: 700; color: #334155; font-size: 13.5px; display: block; margin-bottom: 6px;">Fecha de Operación:</label>
                            <input type="date" id="fecha_pago" name="fecha_pago" required style="width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-weight: 600; color: #1e3a8a;">
                        </div>

                    </div>

                    <!-- Tabla de Integrantes con Saldos Pendientes -->
                    <h5 style="color: #334155; font-weight: 700; margin-bottom: 15px; font-size: 15px;">Integrantes con Saldos Pendientes</h5>
                    
                    <div class="table-responsive" style="border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; margin-bottom: 30px;">
                        <table class="table" style="margin-bottom: 0; vertical-align: middle; text-align: center;">
                            <thead style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                                <tr style="font-size: 11.5px; color: #64748b; font-weight: 700; text-transform: uppercase;">
                                    <th style="padding: 12px;">Crédito</th>
                                    <th style="padding: 12px; text-align: left;">Cliente</th>
                                    <th style="padding: 12px;">Total Préstamo</th>
                                    <th style="padding: 12px;">Ya Amortizado</th>
                                    <th style="padding: 12px;">Cuotas Cobradas</th>
                                    <th style="padding: 12px; width: 180px;">Monto a Cobrar Now</th>
                                </tr>
                            </thead>
                            <tbody>
                                                               <% if (integrantes.length === 0) { %>
                                    <tr>
                                        <td colspan="6" style="padding: 30px; text-align: center; color: #94a3b8; font-style: italic;">
                                            No se registran integrantes con cuotas pendientes en esta junta masiva.
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% integrantes.forEach(function(item) { %>
                                        <% 
                                        // 1. Costo exacto de la cuota individual estándar
                                        const valorCuotaIndividual = parseFloat(item.monto_total) / parseInt(item.total_cuotas);
                                        const yaAmortizado = parseFloat(item.total_ya_pagado);
                                        
                                        // 2. Cuotas completas liquidadas (Redondeo hacia abajo)
                                        let cuotasLiquidadasReales = Math.floor(yaAmortizado / valorCuotaIndividual);
                                        if (cuotasLiquidadasReales > parseInt(item.total_cuotas)) {
                                            cuotasLiquidadasReales = parseInt(item.total_cuotas);
                                        }

                                        // 3. 🌟 NUEVO CÁLCULO DE SALDO RESTANTE EN VIVO:
                                        // Obtenemos cuánto dinero ha aportado el cliente para la cuota que está corriendo actualmente
                                        const dineroAbonadoACuotaActual = yaAmortizado % valorCuotaIndividual;
                                        
                                        let montoSugeridoFinal = valorCuotaIndividual;

                                        // Si hay un dinero parcial flotando (ej. S/ 100), restamos del valor de la cuota para dar el saldo restante
                                        if (dineroAbonadoACuotaActual > 0) {
                                            montoSugeridoFinal = valorCuotaIndividual - dineroAbonadoACuotaActual;
                                        }
                                        %>
                                        <tr style="border-bottom: 1px solid #f1f5f9; font-size: 14px;">
                                            
                                            <!-- Celda ID Préstamo -->
                                            <td style="padding: 14px; font-weight: 800; color: #64748b;">#<%= item.prestamo_id %></td>
                                            
                                            <!-- Celda Cliente -->
                                            <td style="padding: 14px; text-align: left; font-weight: 700; color: #1e293b; text-transform: lowercase; font-variant: small-caps;">
                                                <%= item.cliente_nombre %>
                                            </td>
                                            
                                            <!-- Celda Total a Pagar -->
                                            <td style="padding: 14px; font-weight: 700; color: #16a34a;">
                                                <%= empresa.moneda %> <%= parseFloat(item.monto_total).toFixed(2) %>
                                            </td>
                                            
                                            <!-- Celda Ya Amortizado soles -->
                                            <td style="padding: 14px; font-weight: 700; color: #2563eb;">
                                                <%= empresa.moneda %> <%= parseFloat(item.total_ya_pagado).toFixed(2) %>
                                            </td>
                                            
                                            <!-- Celda Índice de Cuotas -->
                                            <td style="padding: 14px; font-weight: 700; color: #475569;">
                                                <span style="background: #f1f5f9; padding: 3px 8px; border-radius: 4px;">
                                                    <%= cuotasLiquidadasReales %> / <%= item.total_cuotas %>
                                                </span>
                                            </td>
                                            
                                            <!-- Celda Input de Monto Editable Individual (🔄 SUGIERE EL SALDO PENDIENTE AUTOMÁTICAMENTE) -->
                                            <td style="padding: 14px;">
                                                <input type="number" 
                                                       class="form-control input-monto-cobro-grupal" 
                                                       data-prestamo-id="<%= item.prestamo_id %>"
                                                       data-proxima-cuota="<%= parseInt(cuotasLiquidadasReales) + 1 %>"
                                                       value="<%= parseFloat(montoSugeridoFinal).toFixed(2) %>" 
                                                       style="text-align: right; font-weight: 700; color: #1e293b; border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px 12px; outline: none; width: 100%;">
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } %>

                            </tbody>
                        </table>
                    </div>

                    <!-- Footer de Navegación y Guardado -->
                    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 20px;">
                        <a href="/prestamos" style="text-decoration: none; color: #64748b; font-weight: 700; font-size: 14px;">⬅️ Cancelar y Volver</a>
                        <button type="button" onclick="procesarAsentadoCobranzaMasiva()" style="background: #16a34a; color: white; border: none; padding: 11px 25px; border-radius: 6px; font-weight: 700; font-size: 14px; cursor: pointer; box-shadow: 0 4px 6px rgba(22,163,74,0.15); display: inline-flex; align-items: center; gap: 6px;">
                            📥 Registrar Cobranza Completa
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

<!-- SCRIPT OPERATIVO DE ENVÍO TRANSACCIONAL -->
<script>
document.addEventListener("DOMContentLoaded", function() {
    var inputFecha = document.getElementById('fecha_pago');
    if (inputFecha) { inputFecha.value = new Date().toISOString().split('T')[0]; }
});

async function procesarAsentadoCobranzaMasiva() {
    try {
        const metodoPago = document.getElementById('metodo_pago').value;
        const fechaPago = document.getElementById('fecha_pago').value;

        if (!fechaPago) {
            alert("⚠️ Por favor, selecciona una fecha válida de operación.");
            return;
        }

        const inputs = document.querySelectorAll('.input-monto-cobro-grupal');
        const cobrosAProcesar = [];

        inputs.forEach(input => {
            const montoAbonado = parseFloat(input.value);
            if (montoAbonado > 0) {
                cobrosAProcesar.push({
                    prestamo_id: parseInt(input.getAttribute('data-prestamo-id')),
                    num_cuota_pagada: parseInt(input.getAttribute('data-proxima-cuota')),
                    monto_pagado: montoAbonado,
                    fecha_pago: fechaPago,
                    metodo_pago: metodoPago
                });
            }
        });

        if (cobrosAProcesar.length === 0) {
            alert("⚠️ Por favor, digita al menos un monto mayor a cero para asentar cobranzas.");
            return;
        }

        const response = await fetch('/pagos/guardar-masivo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ cobros: cobrosAProcesar })
        });

        const resultado = await response.json();

        if (response.ok && resultado.status === 'success') {
            alert("✅ ¡Cobranza Masiva (" + metodoPago + ") asentada con éxito absoluto en Laragon!");
            window.location.href = '/prestamos';
        } else {
            alert("❌ Error: " + (resultado.mensaje || "Inconveniente en la inyección de datos."));
        }

    } catch (error) {
        console.error("Error al procesar cobranza:", error);
        alert("❌ Inconveniente interno de red al guardar.");
    }
}
</script>

<%- include('../partials/footer') %>
